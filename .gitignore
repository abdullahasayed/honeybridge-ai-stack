.env

# Local migration/backup artifacts — never push (contains the Postgres dump with encrypted credentials)
volume-backups/

# Device-transfer bundle from scripts/package-transfer — contains .env, the DB
# dump, and private docs. Move it out-of-band; never commit it.
transfer-bundle/
# Backups of .env made by scripts/restore-transfer
.env.bak.*

# macOS noise
.DS_Store

shared/rag-files/pending/*
!shared/rag-files/pending/.gitkeep
shared/rag-files/processed/*
!shared/rag-files/processed/.gitkeep
n8n/demo-data/.imported
# Private planning docs and eval data - never push
docs-private/
